{
  "name": "auth-gemini-e2e",
  "private": true,
  "description": "Skenario E2E Playwright untuk kedua website (Auth Emulator + Gemini MOCK)",
  "scripts": {
    "build-shim": "esbuild shim/firebase-shim.js --bundle --format=esm --minify --outfile=.build/firebase-all.js && esbuild shim/google-fake.js --bundle --format=iife --outfile=.build/google-fake.bundle.js",
    "node": "node e2e-node.js",
    "flutter": "node e2e-flutter.js",
    "console": "node console-shots.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "firebase": "12.19.0",
    "playwright": "1.56.1"
  }
}
