{
  "name": "auth-gemini-node-web",
  "version": "1.0.0",
  "description": "Website login/register Node.js (Express + Firebase Auth) dengan fitur Tanya Gemini",
  "main": "server.js",
  "scripts": {
    "build:client": "node scripts/build-client.js",
    "start": "node server.js",
    "dev": "npm run build:client && node server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:emulator": "firebase emulators:exec --only auth --project demo-auth-gemini \"npm test\""
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "firebase": "^13.0.0",
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}