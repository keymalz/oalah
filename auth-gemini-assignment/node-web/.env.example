# Salin menjadi .env lalu isi. JANGAN commit file .env.
PORT=3000
NODE_ENV=development
# Origin yang diizinkan memanggil API (pisahkan dengan koma). Dipakai untuk CORS (Flutter Web).
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Origin website Node.js sendiri (untuk cek header Origin pada request berbasis cookie)
APP_ORIGIN=http://localhost:3000
SESSION_MAX_DAYS=5

# --- Firebase (Project settings > General > Your apps > Web app) ---
FIREBASE_PROJECT_ID=isi-project-id
FIREBASE_API_KEY=isi-web-api-key
FIREBASE_AUTH_DOMAIN=isi-project-id.firebaseapp.com
FIREBASE_APP_ID=isi-app-id
# Kredensial Admin SDK: path ke file service account JSON (jangan masuk Git)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccount.json

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=isi-api-key-dari-google-ai-studio
# Cek nama model yang tersedia untuk akun Anda di AI Studio
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_INPUT_CHARS=2000

# --- Hanya untuk pengujian lokal tanpa akun Google ---
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# GEMINI_MOCK=1
