<%- include('partials/head') %>
<main id="main" class="card auth">
  <h1>Daftar akun</h1>
  <p class="muted">Buat akun baru dengan email dan password, atau gunakan akun Google.</p>

  <div id="alert" class="alert" role="alert" aria-live="assertive" hidden></div>

  <form id="register-form" novalidate>
    <div class="field">
      <label for="name">Nama</label>
      <input id="name" name="name" type="text" autocomplete="name" required>
      <p class="field-error" id="name-error" hidden></p>
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required>
      <p class="field-error" id="email-error" hidden></p>
    </div>
    <div class="field">
      <label for="password">Password</label>
      <div class="pw">
        <input id="password" name="password" type="password" autocomplete="new-password" required aria-describedby="password-hint">
        <button type="button" class="pw-toggle" data-target="password" aria-label="Tampilkan password" aria-pressed="false">Tampilkan</button>
      </div>
      <p class="hint" id="password-hint">Minimal 8 karakter, mengandung huruf dan angka.</p>
      <p class="field-error" id="password-error" hidden></p>
    </div>
    <div class="field">
      <label for="confirm">Konfirmasi password</label>
      <div class="pw">
        <input id="confirm" name="confirm" type="password" autocomplete="new-password" required>
        <button type="button" class="pw-toggle" data-target="confirm" aria-label="Tampilkan konfirmasi password" aria-pressed="false">Tampilkan</button>
      </div>
      <p class="field-error" id="confirm-error" hidden></p>
    </div>
    <button type="submit" class="btn btn-primary" id="submit-btn">Daftar</button>
  </form>

  <div class="divider"><span>atau</span></div>
  <button type="button" class="btn btn-google" id="google-btn">
    <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.2 5.4-4.7 7.1l7.3 5.7c4.3-4 7.2-9.9 7.2-17.3z"/><path fill="#FBBC05" d="M10.5 28.7A14.5 14.5 0 0 1 9.5 24c0-1.6.3-3.2.8-4.7l-7.9-6.1A24 24 0 0 0 0 24c0 3.9.9 7.5 2.6 10.8l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.3-5.7c-2 1.4-4.7 2.3-8.6 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/></svg>
    Daftar dengan Google
  </button>

  <p class="switch">Sudah punya akun? <a href="/login">Masuk</a></p>
</main>
<script src="/config.js"></script>
<script src="/static/js/register.bundle.js" defer></script>
<%- include('partials/foot') %>
