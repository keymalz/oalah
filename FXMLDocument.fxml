<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="450.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="TableView.FXMLDocumentController">
    <children>
        <Label layoutX="124.0" layoutY="14.0" text="Data Mahasiswa">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <TableView fx:id="tvStudent" layoutX="36.0" layoutY="100.0" prefHeight="250.0" prefWidth="378.0">
            <columns>
                <TableColumn fx:id="tcNim" prefWidth="120.0" text="NIM" />
                <TableColumn fx:id="tcNama" prefWidth="257.0" text="Nama" />
            </columns>
        </TableView>
        <TextField fx:id="tfNimBaru" layoutX="36.0" layoutY="60.0" promptText="Input NIM" />
        <TextField fx:id="tfNamaBaru" layoutX="208.0" layoutY="60.0" prefWidth="149.0" promptText="Input Nama" />
        <Button layoutX="369.0" layoutY="60.0" onAction="#tambahButtonAction" text="Tambah" />

        <Button layoutX="175.0" layoutY="365.0" onAction="#bukaJendelaBaruAction" text="Buka Jendela 2" />
    </children>
</AnchorPane>